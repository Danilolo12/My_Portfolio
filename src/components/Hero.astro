---
const personalImageAlt = "Daniel Ramos";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import Download from "./icons/download.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHub from "./icons/GitHub.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-20"
      src="./images/Perfil.webp"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/daniel-ramos-1670252b2/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Available for work</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, I'm Daniel
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-sky-200 [&>strong]:text-sky-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    +3 years of experience. <strong>Full-Stack Developer</strong> based in Colombia.
    Specialized in building unique web and mobile applications.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:danieleduardoramos977@gmail.com">
      <MailIcon class="size-4" />
      Contact me
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/daniel-ramos-1670252b2/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/Danilolo12">
      <GitHub class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill
      href="/Currículum Daniel Ramos Actualizado 2.0.pdf"
      download="Daniel Ramos Resume.pdf"
    >
      <Download class="size-4" />
      CV
    </SocialPill>
  </nav>
</div>
