---
import Icon from '@/components/icons/Icon.astro'
import ChipList from '@/components/ui/ChipList.astro'
import type { Project } from '@/lib/content'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props

const companies = [...new Set(projects.map((project) => project.data.context))]
const formatter = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
---

{
  projects.length > 0 && (
    <section class="reveal mt-16">
      <div class="flex items-center gap-2">
        <Icon name="lock" class="size-3.5 text-subtle" />
        <h3 class="label">Under NDA</h3>
      </div>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
        Systems I helped build at {formatter.format(companies)}. They are the
        company's products and the details are confidential, so this is the
        name, the domain and the stack — nothing further.
      </p>

      <ul class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3">
        {projects.map((project) => (
          <li class="flex flex-col bg-canvas p-5">
            <div class="flex items-center gap-2">
              <h4 class="font-medium tracking-tight">{project.data.title}</h4>
              <span class="label ml-auto">{project.data.year}</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">
              {project.data.tagline}
            </p>
            <ChipList items={project.data.stack} limit={3} class="mt-4" />
          </li>
        ))}
      </ul>
    </section>
  )
}
