---
import ChipList from '@/components/ui/ChipList.astro'
import StatusDot from '@/components/ui/StatusDot.astro'
import { formatDuration, formatRange } from '@/lib/format'
import type { Job } from '@/lib/content'

interface Props {
  job: Job
}

const { job } = Astro.props
const { role, company, companyUrl, location, arrangement, start, end } = job.data
const current = end === null
---

<li class="reveal grid gap-x-8 md:grid-cols-[9rem_1fr]">
  <div class="pt-1 md:text-right">
    <p class="label whitespace-nowrap">{formatRange(start, end)}</p>
    <p class="mt-1 hidden text-xs text-subtle md:block">
      {formatDuration(start, end)}
    </p>
  </div>

  <div class="relative border-line pb-12 md:border-l md:pl-8">
    <span
      class="absolute -left-[4.5px] top-2 hidden size-2 rounded-full bg-line-strong md:block"
      aria-hidden="true"></span>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <h3 class="text-lg font-semibold tracking-tight">{role}</h3>
      {current && <StatusDot />}
    </div>

    <p class="mt-1 text-sm text-muted">
      {
        companyUrl ? (
          <a
            href={companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg underline decoration-line underline-offset-4 hover:decoration-accent"
          >
            {company}
          </a>
        ) : (
          <span class="text-fg">{company}</span>
        )
      }
      <span class="text-subtle"> · {location} · {arrangement}</span>
    </p>

    <p class="mt-4 max-w-2xl leading-relaxed text-muted">{job.data.summary}</p>

    <ul class="mt-4 max-w-2xl space-y-2">
      {
        job.data.highlights.map((highlight) => (
          <li class="relative pl-5 text-sm leading-relaxed text-muted">
            <span class="absolute left-0 top-[0.6em] size-1 rounded-full bg-accent" />
            {highlight}
          </li>
        ))
      }
    </ul>

    <ChipList items={job.data.stack} class="mt-5" />
  </div>
</li>
