---
interface Props {
  id: string
  index: string
  title: string
  lede?: string
  class?: string
}

const { id, index, title, lede, class: className = '' } = Astro.props
---

<section id={id} class:list={['scroll-mt-24 py-16 md:py-24', className]}>
  <header class="reveal mb-12 md:mb-16">
    <div class="flex items-center gap-3">
      <span class="label">{index}</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 class="text-title font-semibold text-balance">{title}</h2>
      {lede && <p class="max-w-md text-sm leading-relaxed text-muted">{lede}</p>}
    </div>
  </header>
  <slot />
</section>
