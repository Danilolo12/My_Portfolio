---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 42rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    color: var(--color-fg);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose :global(h3) {
    margin-top: 2.25rem;
    color: var(--color-fg);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(ul) {
    padding-left: 1.15rem;
    list-style: disc;
  }

  .prose :global(li)::marker {
    color: var(--color-subtle);
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(code) {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-raised);
    padding: 0.1em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-fg);
  }

  .prose :global(hr) {
    margin-block: 2.5rem;
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .prose :global(em) {
    color: var(--color-subtle);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-subtle);
  }
</style>
